#!/bin/bash

# xdg

NIXBOX_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/nixbox"
NIXBOX_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/nixbox"
NIXBOX_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}/nixbox"
NIXBOX_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}/nixbox"

# apptainer

NIXBOX_APPTAINER_BIN_LIST=()
NIXBOX_APPTAINER_BIN_LIST+=("/usr/bin/apptainer" "/bin/apptainer")
NIXBOX_APPTAINER_PATH="${NIXBOX_APPTAINER_BIN_LIST[0]}"

# config

NIXBOX_ROOT="/home/jyjyjcr/opt/nixbox"

NIXBOX_NIX_STORE="$NIXBOX_DATA_HOME/nix.store"
NIXBOX_NIX_VAR="$NIXBOX_STATE_HOME/nix.var"

NIXBOX_SANDBOX_PATH="$NIXBOX_STATE_HOME/sandbox.sif"
RECOVER_PATH="$NIXBOX_ROOT/lib/recover.sh"

DLLIB_PATH="$NIXBOX_STATE_HOME/dllib"

check_host_apptainer() {
  if [ ! -x "$NIXBOX_APPTAINER_PATH" ]; then
    echo "apptainer is already hidden. you seems already in nixbox." >&2
    return 255
  fi
}

build_sandbox() {
  local tmpfile
  local build_status

  tmpfile="$(mktemp)" || return $?
  cat <<EOF > "$tmpfile"
Bootstrap: scratch

%setup
  mkdir -p "\$APPTAINER_ROOTFS/etc"
  : > "\$APPTAINER_ROOTFS/etc/passwd"
  : > "\$APPTAINER_ROOTFS/etc/group"
EOF
  "$NIXBOX_APPTAINER_PATH" build "$NIXBOX_SANDBOX_PATH" "$tmpfile"
  build_status=$?
  rm -f -- "$tmpfile"
  return "$build_status"
}

clear_inherited_apptainer_environment() {
  local prefix var

  for prefix in APPTAINER_ SINGULARITY_; do
    while IFS= read -r var; do
      unset "$var"
    done < <(compgen -e "$prefix")
  done
}

build_exec_options() {
  options=()

  for apptainer_bin in "${NIXBOX_APPTAINER_BIN_LIST[@]}"; do
    options+=("--bind" "/dev/null:$apptainer_bin")
  done

  options+=("--no-mount" "/etc/resolv.conf")
  options+=("--no-mount" "/etc/localtime")
  options+=("--bind" "$NIXBOX_NIX_VAR:/nix/var")
  options+=("--bind" "$NIXBOX_NIX_STORE:/nix/store")

  for p in `find / -mindepth 1 -maxdepth 1`; do
    case "$p" in
      /dev|/proc|/sys|/tmp)
        ;;
      *)
        options+=("--bind" "$p")
        ;;
    esac
  done
}

configure_task() {
  case "$1" in
    login)
      options+=("--cleanenv")
      options+=("--env" "LANG=${LANG}")
      options+=("--env" "LD_LIBRARY_PATH=$DLLIB_PATH/nss")
      options+=("--env" "NIXBOX_DLLIB_ROOT=$DLLIB_PATH")
      ;;
    recover)
      export NIXBOX_RECOVER_PATH="$PATH"
      export NIXBOX_RECOVER_LD_LIBRARY_PATH="$LD_LIBRARY_PATH"
      ;;
    *)
      echo "invalid command specified." >&2
      return 1
      ;;
  esac
}

run_task() {
  exec "$NIXBOX_APPTAINER_PATH" exec "${options[@]}" "$NIXBOX_SANDBOX_PATH" "$RECOVER_PATH" "$@"
}

main() {
  local task="${1:-}"
  shift || true

  check_host_apptainer || return $?

  if [ "$task" = "build" ]; then
    build_sandbox
    return $?
  fi

  clear_inherited_apptainer_environment
  build_exec_options
  configure_task "$task" || return $?

  if [ $# -eq 0 ]; then
    echo "no prompt specified." >&2
    return 2
  fi

  run_task "$@"
}

options=()
main "$@"
