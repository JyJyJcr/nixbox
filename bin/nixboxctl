#!/bin/bash

# xdg

NIXBOX_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/nixbox"
NIXBOX_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/nixbox"
NIXBOX_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}/nixbox"
NIXBOX_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}/nixbox"

# apptainer

NIXBOX_APPTAINER_BIN_LIST=()
NIXBOX_APPTAINER_BIN_LIST+=("/usr/bin/apptainer" "/bin/apptainer")
NIXBOX_APPTAINER_PATH="${NIXBOX_APPTAINER_BIN_LIST[0]}"

NIXBOX_SCRIPT_PATH="$0"
NIXBOX_SCRIPT_PATH="$(readlink -f -- "$NIXBOX_SCRIPT_PATH")" || exit 255

NIXBOX_NIX_STORE="$NIXBOX_DATA_HOME/nix.store"
NIXBOX_NIX_VAR="$NIXBOX_STATE_HOME/nix.var"

NIXBOX_SANDBOX_PATH="$NIXBOX_STATE_HOME/sandbox.sif"

NIXBOX_DLLIB_PATH="$NIXBOX_STATE_HOME/dllib"

nixbox_check_host_apptainer() {
  if [ ! -x "$NIXBOX_APPTAINER_PATH" ]; then
    echo "apptainer is already hidden. you seems already in nixbox." >&2
    return 255
  fi
}

nixbox_build_sandbox() {
  local tmpfile
  local build_status

  tmpfile="$(mktemp)" || return $?
  cat <<EOF > "$tmpfile"
Bootstrap: scratch

%setup
  mkdir -p "\$APPTAINER_ROOTFS/etc"
  : > "\$APPTAINER_ROOTFS/etc/passwd"
  : > "\$APPTAINER_ROOTFS/etc/group"
EOF
  "$NIXBOX_APPTAINER_PATH" build "$NIXBOX_SANDBOX_PATH" "$tmpfile"
  build_status=$?
  rm -f -- "$tmpfile"
  return "$build_status"
}

nixbox_install() {
  mkdir -p \
    "$NIXBOX_CONFIG_HOME" \
    "$NIXBOX_DATA_HOME" \
    "$NIXBOX_STATE_HOME" \
    "$NIXBOX_CACHE_HOME" \
    "$NIXBOX_NIX_STORE" \
    "$NIXBOX_NIX_VAR" \
    "$NIXBOX_DLLIB_PATH/nss" || return $?

  nixbox_build_sandbox
}

nixbox_clear_apptainer_environment() {
  local prefix var

  for prefix in APPTAINER_ SINGULARITY_; do
    while IFS= read -r var; do
      unset "$var"
    done < <(compgen -e "$prefix")
  done
}

nixbox_build_exec_options() {
  local -n options_ref="$1"
  options_ref=()

  for apptainer_bin in "${NIXBOX_APPTAINER_BIN_LIST[@]}"; do
    options_ref+=("--bind" "/dev/null:$apptainer_bin")
  done

  options_ref+=("--no-mount" "/etc/resolv.conf")
  options_ref+=("--no-mount" "/etc/localtime")
  options_ref+=("--bind" "$NIXBOX_NIX_VAR:/nix/var")
  options_ref+=("--bind" "$NIXBOX_NIX_STORE:/nix/store")

  for p in `find / -mindepth 1 -maxdepth 1`; do
    case "$p" in
      /dev|/proc|/sys|/tmp)
        ;;
      *)
        options_ref+=("--bind" "$p")
        ;;
    esac
  done
}

nixbox_add_login_options() {
  local -n options_ref="$1"

  options_ref+=("--cleanenv")
  options_ref+=("--env" "LANG=${LANG}")
  options_ref+=("--env" "LD_LIBRARY_PATH=$NIXBOX_DLLIB_PATH/nss")
  options_ref+=("--env" "NIXBOX_DLLIB_ROOT=$NIXBOX_DLLIB_PATH")
}

nixbox_add_recover_options() {
  local -n options_ref="$1"

  options_ref+=("--env" "NIXBOX_RECOVER_PATH=$PATH")
  options_ref+=("--env" "NIXBOX_RECOVER_LD_LIBRARY_PATH=$LD_LIBRARY_PATH")
}

nixbox_recover() {
  local var new_var

  if [ $# -eq 0 ]; then
    echo "no prompt specified." >&2
    return 2
  fi

  while IFS= read -r var; do
    new_var="${var#NIXBOX_RECOVER_}"
    printf -v "$new_var" '%s' "${!var}"
    export "$new_var"
    unset "$var"
  done < <(compgen -e NIXBOX_RECOVER_)

  unset PROMPT_COMMAND
  exec "$@"
}

nixbox_exec() {
  local task="$1"
  local -a options=()
  shift

  if [ $# -eq 0 ]; then
    echo "no prompt specified." >&2
    return 2
  fi

  nixbox_build_exec_options options
  case "$task" in
    login)
      nixbox_add_login_options options
      ;;
    recover)
      nixbox_add_recover_options options
      ;;
  esac

  nixbox_clear_apptainer_environment

  exec "$NIXBOX_APPTAINER_PATH" exec "${options[@]}" "$NIXBOX_SANDBOX_PATH" "$NIXBOX_SCRIPT_PATH" __recover "$@"
}

main() {
  local task="${1:-}"
  shift || true

  if [ "$task" = "__recover" ]; then
    nixbox_recover "$@"
    return $?
  fi

  nixbox_check_host_apptainer || return $?

  case "$task" in
    install)
      nixbox_install
      return $?
      ;;
    login|recover)
      nixbox_exec "$task" "$@"
      ;;
    *)
      echo "invalid command specified." >&2
      return 1
      ;;
  esac
}

main "$@"
